  "system_classification": {
    "tier": "research_backup",
    "tier_label": "研究/备用量表",
    "clinical_role": "research"
  },
  "source_url": "https://pubmed.ncbi.nlm.nih.gov/4378854/",
  "original_paper": "Zung WWK, Richards CB, Short MJ. Self-rating depression scale in an outpatient clinic. Further validation of the SDS. Arch Gen Psychiatry. 1965;13(6):508-515.",
  "license_note": "当前系统题干来自中文原型改写包，仅建议用于研究、课程项目和原型演示。不同中文场景的 cutoff 与用词适配需要单独验证。",
  "validated_population": "经典成人抑郁自评工具，中文老年和社区样本存在应用研究，但不同场景阈值差异较大。",
  "screening_only": true,
  "estimated_minutes": 6,
  "total_questions": 20,
  "instruction": "请根据您最近一段时间的实际情况，选择每一项描述与您相符的程度。",
  "scoring": {
    "type": "weighted",
    "max_raw_score": 80,
    "max_standard_score": 100,
    "reverse_questions": [
      2,
      5,
      6,
      11,
      12,
      14,
      16,
      17,
      18,
      20
    ],
    "note": "系统按原始分求和后乘以 1.25 计算指数分；反向题已在选项分值中处理。"
  },
  "thresholds": [
