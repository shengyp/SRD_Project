{
  "code": "SDS",
  "name": "Zung抑郁自评量表",
  "full_name": "Zung Self-Rating Depression Scale",
  "version": "Chinese Simplified v1.0",
  "description": "SDS由Zung于1965年编制，是国内最经典、使用最广泛的抑郁自评量表之一。共20道题目，采用1-4级评分（反向题采用4-1分），标准分=粗分×1.25（取整数）。专为评估中国患者抑郁状态设计，在中文人群中积累了丰富的临床数据。",
  "purpose": "抑郁自评（国内经典量表，与PHQ-9互补验证）",
  "estimated_minutes": 6,
  "total_questions": 20,
  "instruction": "请仔细阅读每一条陈述，然后根据您最近一周的实际情况，在相应的选项上划圈。",
  "scoring": {
    "type": "weighted",
    "max_raw_score": 80,
    "max_standard_score": 100,
    "reverse_questions": [2, 5, 6, 11, 12, 14, 16, 17, 18, 20],
    "note": "第2、5、6、11、12、14、16、17、18、20题为反向计分题（选项从“没有或很少时间”到“绝大部分或全部时间”反向赋分为4-1分）"
  },
  "thresholds": [
    {
      "min": 0,
      "max": 52,
      "level": "normal",
      "label": "正常范围",
      "label_en": "Normal",
      "risk_level": "low",
      "suggestion": "无明显抑郁症状"
    },
    {
      "min": 53,
      "max": 62,
      "level": "mild",
      "label": "轻度抑郁",
      "label_en": "Mild Depression",
      "risk_level": "low",
      "suggestion": "建议心理疏导和健康教育，1个月后复测"
    },
    {
      "min": 63,
      "max": 72,
      "level": "moderate",
      "label": "中度抑郁",
      "label_en": "Moderate Depression",
      "risk_level": "medium",
      "suggestion": "建议药物干预联合心理治疗"
    },
    {
      "min": 73,
      "max": 100,
      "level": "severe",
      "label": "重度抑郁",
      "label_en": "Severe Depression",
      "risk_level": "high",
      "suggestion": "建议立即寻求专业心理/精神科帮助，评估住院必要性"
    }
  ],
  "alternative_threshold": {
    "method": "抑郁严重指数",
    "formula": "抑郁严重指数 = 粗分 / 80",
    "thresholds": [
      { "min": 0, "max": 0.49, "level": "none", "label": "无抑郁" },
      { "min": 0.5, "max": 0.59, "level": "mild", "label": "轻度抑郁" },
