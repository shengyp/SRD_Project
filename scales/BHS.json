{
  "code": "BHS",
  "name": "贝克绝望量表",
  "full_name": "Beck Hopelessness Scale",
  "version": "Chinese Simplified v1.0",
  "description": "BHS由Aaron Beck于1974年编制，是测量绝望感（对未来的消极期待）的经典量表。共20道是/否题，总分0-20分。绝望是抑郁和自杀行为之间的核心中介变量，是自杀意念和自杀行为的独立预测因子，在自杀风险评估中具有不可替代的作用。",
  "purpose": "绝望感评估（自杀意念与行为的独立预测因子）",
  "estimated_minutes": 5,
  "total_questions": 20,
  "instruction": "请仔细阅读以下每一条陈述，然后根据您的真实感受，选择"是"或"否"。",
  "scoring": {
    "type": "sum",
    "max_score": 20,
    "reverse_questions": [1, 3, 5, 6, 8, 10, 13, 15, 19],
    "note": "第1、3、5、6、8、10、13、15、19题为反向计分题（选择"是"得0分），其余为正向计分题（选择"是"得1分）"
  },
  "thresholds": [
    {
      "min": 0,
      "max": 3,
      "level": "normal",
      "label": "正常范围",
      "label_en": "Normal Hopelessness",
      "risk_level": "low",
      "suggestion": "无明显绝望感"
    },
    {
      "min": 4,
      "max": 8,
      "level": "mild",
      "label": "轻度绝望",
      "label_en": "Mild Hopelessness",
      "risk_level": "low",
      "suggestion": "关注心理健康，可进行一般性心理疏导"
    },
    {
      "min": 9,
      "max": 14,
      "level": "moderate",
      "label": "中度绝望",
      "label_en": "Moderate Hopelessness",
      "risk_level": "medium",
      "suggestion": "建议进行心理评估和干预，关注自杀风险"
    },
    {
      "min": 15,
      "max": 20,
      "level": "severe",
      "label": "重度绝望",
      "label_en": "Severe Hopelessness",
      "risk_level": "high",
      "suggestion": "高自杀风险信号，建议立即进行专项自杀风险评估（C-SSRS）和临床干预"
    }
  ],
  "cutoff_suicide_risk": 9,
  "cutoff_note": "以9分为自杀风险cutoff，得分>9分的患者自杀风险显著升高",
  "factor_structure": {
    "future_feeling": [1, 5, 6, 10, 13, 15, 19],
    "motivation_loss": [2, 3, 9, 11, 12, 16, 17, 20],
    "future_expectation": [4, 7, 8, 14, 18]
  },
  "questions": [
