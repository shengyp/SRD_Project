# VIS4SRD 后端配置
# 复制此文件为 .env 并修改相应值

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=3000

# ==================== MySQL 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=mental_user
DB_PASSWORD=mental_password
DB_NAME=vis4srd

# ==================== PostgreSQL 数据库配置 ====================
PG_HOST=localhost
PG_PORT=5432
PG_NAME=mental_health
PG_USER=postgres
PG_PASSWORD=PgStr0ng2o26#vis4srd

# ==================== 高德地图 API ====================
# 用于心理机构地理编码和逆地理编码
AMAP_WEB_SERVICE_KEY=your_amap_key_here

# ==================== LLM 模型配置（智能问答） ====================
# DeepSeek API（推荐，免费额度）
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ==================== SuiAgent 知识库路径 ====================
# 知识库根目录（相对于 backend 目录）
SUIIAGENT_KNOWLEDGE_PATH=./SuiAgent-main/rag-skill/knowledge

# ==================== JWT 认证配置 ====================
JWT_SECRET_KEY=vis4srd_jwt_secret_key_2024_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== 初始化配置 ====================
# 设置为 true 强制重新初始化数据库（仅首次或重置时使用）
FORCE_INIT=false
