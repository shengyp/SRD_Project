# VIS4SRD 后端配置
# 复制此文件为 .env 并修改相应值

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8000

# ==================== MySQL 数据库配置 ====================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=vis4srd

# ==================== PostgreSQL 数据库配置 ====================
PG_HOST=127.0.0.1
PG_PORT=5432
PG_NAME=mental_health
PG_USER=postgres
PG_PASSWORD=your_pg_password

# ==================== 高德地图 API ====================
# 用于心理机构地理编码和逆地理编码
AMAP_WEB_SERVICE_KEY=your_amap_key_here

# ==================== LLM 模型配置（智能问答 / 开发态） ====================
# 默认建议使用 qwen-flash，按你自己的网关与 key 修改
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=qwen-flash

# ==================== SuiAgent 知识库路径 ====================
# 知识库根目录（相对于 backend 目录）
SUIIAGENT_KNOWLEDGE_PATH=./SuiAgent-main/rag-skill/knowledge

# ==================== JWT 认证配置 ====================
JWT_SECRET_KEY=replace_me_in_local_env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== 初始化配置 ====================
# 设置为 true 强制重新初始化数据库（仅首次或重置时使用）
FORCE_INIT=false
