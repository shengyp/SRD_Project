# VIS4SRD 生产环境变量
# 此文件在 docker build 时被 Vite 自动读取
#
# 【重要】生产环境通过 Nginx 代理，使用相对路径
# 前端请求 /api/* → Nginx 转发到后端 :3000
# 不需要也不应该在这里填服务器 IP/域名！

# ==================== 高德地图配置（必须） ====================
# Web端 API Key
VITE_AMAP_KEY=3c8c2ded39b09bc81c28516e8e4f6c11
# 高德地图 JS API Key（与 Web 端 Key 相同）
VITE_AMAP_JS_KEY=3c8c2ded39b09bc81c28516e8e4f6c11
# 高德地图安全密钥
VITE_AMAP_SECURITY_CODE=f36eed3c7e00912a78fd9b948a34d9d9
