# VIS4SRD 前端开发环境变量
# 挂载到 docker-compose.dev.yml 的 frontend 服务

# API 基础地址（空 = 使用相对路径，通过 Vite proxy 代理到后端）
VITE_API_BASE=

# 高德地图 Key（用于地图组件）
VITE_AMAP_KEY=3c8c2ded39b09bc81c28516e8e4f6c11
VITE_AMAP_JS_KEY=3c8c2ded39b09bc81c28516e8e4f6c11
VITE_AMAP_SECURITY_CODE=f36eed3c7e00912a78fd9b948a34d9d9

# Windows 下 bind mount 必须开启轮询才能触发 HMR
CHOKIDAR_USEPOLLING=true
